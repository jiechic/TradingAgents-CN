FROM node:22-bookworm-slim AS build
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
COPY docs/ /src/docs/
COPY assets/ /src/assets/
RUN mkdir -p public/assets && cp -a /src/assets/. public/assets/ && npx vite build
FROM nginx:stable-alpine
ARG VCS_REF
LABEL org.opencontainers.image.source="https://github.com/jiechic/TradingAgents-CN" \
      org.opencontainers.image.version="3.0.0" \
      org.opencontainers.image.revision=$VCS_REF
COPY --from=build /src/frontend/dist/ /usr/share/nginx/html/
COPY docker/frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1
