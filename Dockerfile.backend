FROM python:3.11-slim-bookworm
ARG VCS_REF
ARG APP_VERSION
LABEL org.opencontainers.image.source="https://github.com/jiechic/TradingAgents-CN" \
      org.opencontainers.image.version=$APP_VERSION \
      org.opencontainers.image.revision=$VCS_REF
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Asia/Shanghai DOCKER_CONTAINER=true
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gcc g++ libffi-dev libpango-1.0-0 libpangoft2-1.0-0 \
    libharfbuzz-subset0 fonts-noto-cjk pandoc && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
# Upstream uv.lock belongs to an older project; resolve the current pyproject instead.
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .
COPY . .
RUN python tools/write_build_info.py --revision "$VCS_REF" --version "$APP_VERSION"
RUN mkdir -p data logs reports results cache && python -m compileall -q app core migrations tradingagents
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
